{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Read(./.env*)",
      "Read(./auth.json)",
      "Read(./storage/app/private/**)",
      "Read(./storage/logs/**)",
      "Read(./database/*.sqlite*)",
      "Read(./infra/edge/*.generated)",
      "Read(./test-results/**)",
      "Read(./playwright-report/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/protect-files.ps1",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/refresh-context.ps1",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
