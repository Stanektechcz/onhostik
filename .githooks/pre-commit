#!/bin/sh
set -eu

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
blocked="$(printf '%s\n' "$staged" \
  | grep -E '^(\.env($|\.)|auth\.json$|storage/app/private/|storage/logs/|database/.*\.sqlite($|-)|infra/edge/.*\.generated$)' \
  | grep -Ev '^(\.env\.example|storage/app/private/\.gitignore|storage/logs/\.gitignore)$' || true)"

if [ -n "$blocked" ]; then
  echo "ONHOST: commit blocked because a private runtime file is staged." >&2
  exit 1
fi

powershell.exe -NoProfile -ExecutionPolicy Bypass -File brain.ps1 security -Quick -Json >/dev/null
powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/ai/tests/Config.Tests.ps1
