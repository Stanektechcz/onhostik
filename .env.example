APP_NAME=ONhost
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Surfaces, console relay, partner white-label (see docs/adr/0005, docs/runbooks/console-relay.md)
ONHOST_UI_DEMO=false
ONHOST_SURFACES_PATH=
ONHOST_CONSOLE_RELAY_KEY=
ONHOST_WHITELABEL_CNAME=panel.onhost.cz
WEDOS_TEST_MODE=true   # production: false (WAPI test flag makes registry operations dry-run; Subreg has no test flag — use a demoreg.net sandbox instance while true)
WEDOS_FORCE_IP_RESOLVE=v4   # WAPI redirects IPv6 clients to a 404 page — call it over the allow-listed IPv4 egress
ONHOST_REGISTRAR_PREFERENCE=wedos,subreg   # tie-break order when registrar cost prices are equal or unknown
ONHOST_REGISTRAR_COST_TTL_HOURS=24         # registrar price-book rows older than this count as stale (doctor warning)
ONHOST_FX_EUR_CZK=25.0                     # only for comparing registrar cost prices quoted in EUR/USD
ONHOST_FX_USD_CZK=23.0
ONHOST_DOMAIN_TERMS_URL=/dokumenty/podminky-registrace-domen   # ONhost domain terms shown to customers (never the registrar's)
ONHOST_DRIFT_AUTO_REPAIR=false
ONHOST_ORDER_DUPLICATE_WINDOW_MINUTES=15
ONHOST_METRICS_TOKEN=
ONHOST_METRICS_ALLOW_IPS=127.0.0.1,::1
ONHOST_CONSOLE_RELAY_URL=

# Payments: card gateway (Comgate by default; GoPay/Stripe adapters exist) and the bank account printed on proformas,
# top-up instructions and QR codes (also used by LegalEntitySeeder; statement import matches by variable symbol)
PAYMENT_GATEWAY=comgate
COMGATE_MERCHANT=
COMGATE_SECRET=
COMGATE_TEST=true   # production: false
COMGATE_RECURRING=true          # stored cards for automatic top-ups (needs recurring payments on the merchant contract)
STRIPE_RECURRING=true           # Stripe off-session charges of kept cards (STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET via STRIPE_SECRET_REF)
GOPAY_RECURRING=true            # GoPay ON_DEMAND recurrence (GOPAY_GOID + GOPAY_CLIENT_ID / GOPAY_CLIENT_SECRET)
ONHOST_ORDER_RISK=true          # order intake pre-check; hold threshold ONHOST_ORDER_RISK_HOLD (default 60), staff tune it in the console
ONHOST_ORDER_RISK_FEEDBACK_STEP=5       # how much a staff release/reject moves each signal's weight
ONHOST_ORDER_RISK_GEO_ENDPOINT=         # e.g. https://get.geojs.io/v1/ip/country/{ip}.json — country signal; empty = none
ONHOST_QUEUE_BACKLOG_THRESHOLD=25       # operations due for longer than ONHOST_QUEUE_BACKLOG_AGE_MINUTES (5) → platform.queue.backlog alert + gauge
ONHOST_BANK_IBAN=
ONHOST_BANK_BIC=
ONHOST_BANK_ACCOUNT=
ONHOST_BANK_FIO_TOKEN=
ONHOST_LEGAL_ENTITY=onhost-cz

# Web toolkit (docs/runbooks/web-tools.md): staged uploads, staging sites, CDN edge, ACME, uptime monitoring, off-site backups
ONHOST_UPLOAD_MAX_BYTES=2147483648
ONHOST_STAGING_SUFFIX=web.onhost.cz
ONHOST_CDN_CLOUDFLARE_SECRET_REF=          # db://… secret with token + account_id; empty = CDN not offered
ONHOST_ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory
ONHOST_ACME_CONTACT=
ONHOST_ACME_RENEW_DAYS=30
ONHOST_MONITORING_FAILURES=3
ONHOST_MONITORING_RETENTION_DAYS=90
ONHOST_BACKUP_OFFSITE_DISK=                # a filesystems.disks entry (S3-compatible); empty = no off-site copies
ONHOST_BACKUP_DAILY_HOUR=2

# Discord control and action hooks (docs/runbooks/web-tools.md §Discord): the developer-portal application, its interaction
# public key (Ed25519), the bot token secret (`token`) used to register the /onhost command; empty application id = Discord off
ONHOST_DISCORD_APPLICATION_ID=
ONHOST_DISCORD_PUBLIC_KEY=
ONHOST_DISCORD_BOT_SECRET_REF=env://DISCORD_BOT
DISCORD_BOT_TOKEN=

# Platform zones (docs/runbooks/web-tools.md §DNS): zones adopted with `onhost:dns:adopt` where hosting subdomains get A/AAAA rows
ONHOST_PLATFORM_ZONES=onhost.cz
ONHOST_PLATFORM_ORGANIZATION_SLUG=onhost-platform

# Chargebacks (docs/runbooks/web-tools.md §5i): default share of the unused period credited back; editable in the console (Finance)
ONHOST_CHARGEBACK_PERCENT=70

# Rebalancing thresholds (sold RAM / capacity per node) and queue helpers on the backlog gauge
ONHOST_REBALANCE_HIGH=0.85
ONHOST_REBALANCE_LOW=0.6
ONHOST_REBALANCE_TARGET=0.75
ONHOST_QUEUE_AUTOSCALE=false               # true = `onhost:queue:scale --apply` every 5 minutes
ONHOST_QUEUE_MAX_HELPERS=3
ONHOST_QUEUE_COOLDOWN_MINUTES=15
ONHOST_QUEUE_MAX_TIME=900

# Ecosystem block (docs/runbooks/web-tools.md §5j): marketplace share and auto-accept window, referral rewards (minor units), the
# on-time streak, chargeback clusters, sandbox tenants, regional pricing and the green profile of the CZ1 region
ONHOST_MARKETPLACE_COMMISSION=20
ONHOST_MARKETPLACE_AUTO_ACCEPT_DAYS=14
ONHOST_REFERRAL_CREDIT=20000
ONHOST_REFERRAL_WELCOME_CREDIT=10000
ONHOST_REFERRAL_MONTHLY_CAP=20
ONHOST_STREAK_MONTHS=12
ONHOST_STREAK_DISCOUNT=5
ONHOST_CHARGEBACK_CLUSTER_THRESHOLD=3
ONHOST_CHARGEBACK_CLUSTER_DAYS=30
ONHOST_SANDBOX_CREDIT=500000
ONHOST_PRICING_EU_ADJUST=5
ONHOST_GREEN_CZ1_SOURCE=renewable
ONHOST_GREEN_CZ1_GCO2=20
ONHOST_GREEN_CZ1_PUE=1.25
ONHOST_GREEN_CZ1_RENEWABLE=100
ONHOST_GREEN_WATTS_PER_GB=3.5
ONHOST_GREEN_MEASURED_MAX_AGE_HOURS=24    # a probe's watts (POST /v1/probes/power) replace the model this long (§5k-6)
ONHOST_STATUS_CNAME=                      # CNAME target of the customers' own status hosts (§5k-3); empty = the portal host
ONHOST_NODE_SAMPLES_RETENTION_DAYS=30     # hourly node samples behind the 7-day trend (§5k-7)
ONHOST_MARKETPLACE_OVERDUE_GRACE_DAYS=7   # days past a marketplace due date before the customer may take a refund without a dispute (§5l-2)
ONHOST_MARKETPLACE_LATE_CREDIT_PCT=5      # percent of the net price credited per day late when a late delivery is accepted (§5m-2)
ONHOST_MARKETPLACE_LATE_CREDIT_CAP=50     # cap of the late credit in percent of the net price (§5m-2)
ONHOST_CAPACITY_WARN_DAYS=30              # a role/region pool with fewer days of sellable RAM left warns operations daily (§5m-7)
ONHOST_MARKETPLACE_MISSED_PERIOD_CREDIT=50 # percent of a monthly listing's period price credited when the period ended without a deliverable (§5n-2)
ONHOST_MARKETPLACE_PERIOD_WARN_PCT=80     # how far into an unserved period the partner is reminded (§5n-2)
ONHOST_LOYALTY_FORECAST_DEFAULT_PCT=25    # expected completion of a mission nobody completed lately, for the campaign forecast (§5n-5)
ONHOST_PARTNER_AUTO_RATE_LOCK_MONTHS=6    # the rule partners.auto_approve approves rate locks up to this length (§5o-1)
ONHOST_PARTNER_AUTO_CLEAN_MONTHS=12       # months since approval without a rejected payout before payout terms are approved by rule (§5o-1)
ONHOST_BMC_TEMP_WARN_C=75                 # a host at or above this temperature (Redfish Thermal) alerts operations (§5o-6)
ONHOST_NODE_BOOTSTRAP_CALLBACK=           # base URL the vendor node calls back (default APP_URL) (§5o-7)
ONHOST_NODE_BOOTSTRAP_SSH_KEY=            # the operator's public key placed on vendor-ordered nodes by cloud-init (§5o-7)
ONHOST_NODE_BOOTSTRAP_USER_DATA=          # optional cloud-init template override ({callback}, {token}, {request}, {role}, {region}, {ssh_key}) (§5o-7)
ONHOST_PARTNER_DEFAULT_MODEL=share        # the commission model a partner may return to by rule after a clean year (§5p-5)
ONHOST_ONCALL_PROVIDER=                   # pagerduty | opsgenie | webhook; empty = alerts only in the console (§5q-1)
ONHOST_ONCALL_SECRET_REF=env://ONHOST_ONCALL # secret with {routing_key} / {api_key} / {url, secret} (onhost:integrations:secret)
ONHOST_ONCALL_INBOUND_SECRET=             # PagerDuty webhook signing secret or the token the pager sends in X-ONhost-Oncall-Token
ONHOST_ONCALL_ESCALATE_MINUTES=15         # unacknowledged alerts re-page after this many minutes
ONHOST_ONCALL_MAX_ESCALATIONS=2
SENTRY_DSN=                               # error tracking (§5q-2); empty = off
OTEL_EXPORTER_OTLP_ENDPOINT=              # http://otel-collector:4318 — command, operation-step and provider-call spans (§5q-2)
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=onhost-control-plane
ONHOST_FILES_DISK=local                   # local | s3 — marketplace evidence and data exports (§5q-4)
ONHOST_FILES_SIGNED_TTL=15
ONHOST_EVIDENCE_RETENTION_MONTHS=36
ONHOST_CAPACITY_BUDGET_MONTHLY_MINOR=0    # monthly cap on vendor node orders in minor units, 0 = none (§5q-5)
ONHOST_CAPACITY_BUDGET_CURRENCY=EUR
ONHOST_GAME_NODE_RESERVE_MB=1024          # RAM left to the host when a game node limit is detected from Wings (console: Změřit RAM)
TURNSTILE_SITE_KEY=                       # Cloudflare Turnstile on registration and checkout (§5q-6); empty = off
TURNSTILE_SECRET_KEY=
ONHOST_TURNSTILE_ENFORCE_REGISTER=true
ONHOST_TURNSTILE_ENFORCE_FORMS=true      # public contact, tender and partner application forms (§5r-6)
ONHOST_TRACE_URL=                         # https://grafana…/explore?…{trace_id}… — trace links in the console (§5r-2)
ONHOST_CLAMAV_HOST=                       # clamd for uploads (§5r-4); empty = no scan
ONHOST_CLAMAV_PORT=3310
ONHOST_CLAMAV_ENFORCE=true
ONHOST_GAME_UPLOAD_MAX_MB=100             # binary uploads to game servers from the console (§5r-3)
ONHOST_GAME_OPERATOR_ROTATION_DAYS=180     # remind to rotate the Steam account (§5u-5)
ONHOST_GAME_OPERATOR_VARIABLES_REF=db://game/operator-variables  # read-only egg variables (Steam account) — onhost:game:operator-variable (§5s)
ONHOST_REFERRAL_CLAWBACK_DAYS=90          # a chargeback of a referred organization within this window claws the referral back (§5l-4)
