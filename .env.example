APP_NAME=OnHost
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Prague
APP_URL=http://localhost:8000

# Customer panel entry link used by the public site header/footer.
CUSTOMER_PANEL_URL=/panel

APP_LOCALE=cs
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=cs_CZ

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL/MariaDB is the intended dev database (credit ledger triggers are
# MySQL-specific). XAMPP defaults: user root, empty password.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=onhost
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# PRODUCTION: set to true when running over HTTPS
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=reverb

# PRODUCTION: generate strong random values for REVERB_APP_KEY and REVERB_APP_SECRET
REVERB_APP_ID=onhost
REVERB_APP_KEY=onhost-key
REVERB_APP_SECRET=onhost-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@onhost.local"
MAIL_FROM_NAME="${APP_NAME}"

SCOUT_DRIVER=collection
TELESCOPE_ENABLED=false
PULSE_ENABLED=false

# ---------------------------------------------------------------------------
# Local admin seed (DEV ONLY — never use these values in production)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@onhost.local
ADMIN_PASSWORD=password

# ---------------------------------------------------------------------------
# Billing (placeholders — real values are a business/accounting decision)
# ---------------------------------------------------------------------------
BILLING_CURRENCY_DEFAULT=CZK
BILLING_INVOICE_DUE_DAYS=14
BILLING_CREDIT_LOW_THRESHOLD=10000
BILLING_COMPANY_NAME="Onhost.cz s.r.o."
BILLING_COMPANY_IC=
BILLING_COMPANY_DIC=
BILLING_COMPANY_STREET=
BILLING_COMPANY_CITY=
BILLING_COMPANY_ZIP=
BILLING_BANK_CZK=
BILLING_BANK_EUR=

# ---------------------------------------------------------------------------
# External integrations — ALL MOCK/TEST MODE in development.
# Real credentials must never be committed. Real API calls require explicit
# approval (see docs/architecture.md).
# ---------------------------------------------------------------------------
PROVISIONING_MOCK_MODE=true
PROVISIONING_RETENTION_DAYS=30

# WEDOS WAPI (domains) — mock/test only in dev
WAPI_USER=
WAPI_PASSWORD=
WAPI_TEST_MODE=true

# aaPanel (webhosting) — mock only in dev
AAPANEL_TIMEOUT=30
AAPANEL_VERIFY_TLS=false

# Comgate (payments) — test mode only in dev, no real merchant id locally
COMGATE_MERCHANT_ID=
COMGATE_SECRET=
COMGATE_TEST_MODE=true
# PRODUCTION: set to comma-separated IPs from https://help.comgate.cz (Comgate docs)
COMGATE_IP_WHITELIST=

# Stripe (payments) — obtain from dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
# Obtain webhook secret: stripe listen --forward-to /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# GoPay (payments) — obtain from https://help.gopay.com/cs
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
GOPAY_GO_ID=
GOPAY_BASE_URL=https://gw.sandbox.gopay.com/api

# AI / monitoring / backups — mock-first, wired in later phases
AI_MOCK_MODE=true
MONITORING_MOCK_MODE=true
BACKUP_LOCAL_ONLY=true

# Claude AI model (cost-efficient default; upgrade to claude-sonnet-5 for complex tasks)
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Uptime Kuma monitoring (v1.23+ REST API required)
UPTIME_KUMA_URL=
UPTIME_KUMA_API_TOKEN=
UPTIME_KUMA_INTERVAL=60

# S3-compatible backup storage (Hetzner Object Storage / MinIO / AWS S3)
S3_BACKUP_KEY=
S3_BACKUP_SECRET=
S3_BACKUP_BUCKET=onhost-backups
S3_BACKUP_ENDPOINT=
S3_BACKUP_REGION=eu-central-1
# true for MinIO / Hetzner, false for AWS
S3_BACKUP_PATH_STYLE=true

# ---------------------------------------------------------------------------
# REAL-PROVIDER APPROVAL GATES (Phase 3+) — keep FALSE until production go-live.
# Flipping the admin UI flags is never enough; these env gates must also open.
# ---------------------------------------------------------------------------
AAPANEL_ALLOW_REAL_WRITES=false
WAPI_ALLOW_REAL_WRITES=false
AI_ALLOW_REAL_CALLS=false
