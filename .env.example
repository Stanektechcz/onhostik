# =====================================================================================================================
# ONhost control plane — environment template for STAGING and PRODUCTION
# ---------------------------------------------------------------------------------------------------------------------
# Copy to `.env` (or /etc/onhost/app.env for systemd) and fill the empty values with the staging credentials; production
# gets the same file with production values and the switches marked "production:" flipped. Never commit a filled copy.
#
# Provider credentials (Proxmox, PBS, ISPConfig, aaPanel, Pterodactyl, PowerDNS, RKE2, WEDOS, Subreg, Hetzner)
# are NOT here: store them encrypted with `php artisan onhost:integrations:secret <instance> <key> --check`
# (or Nastavení systému → Integrace). Every other `db://…` reference below (pager, Discord, AI, Peppol, OIDC, CDN)
# is filled with `php artisan onhost:secrets:set <ref> <key>`; the Steam account with `onhost:game:operator-variable`.
#
# After every change: `php artisan config:cache` on the app host, restart `onhost-queue@*` and `onhost-scheduler`,
# then `php artisan onhost:doctor` (0 FAIL) — see docs/runbooks/go-live-checklist.md.
# =====================================================================================================================

# ── Application ───────────────────────────────────────────────────────────────────────────────────────────────────────
APP_NAME=ONhost
APP_ENV=staging                            # staging | production (local only on a developer machine)
APP_KEY=                                   # php artisan key:generate — never reuse between staging and production
APP_DEBUG=false
APP_URL=https://staging.onhost.cz          # public origin of the surfaces and the API (https)
APP_LOCALE=cs
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=cs_CZ
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
SANCTUM_STATEFUL_DOMAINS=staging.onhost.cz # the hosts of the surfaces (comma-separated); the panel signs in with the session cookie
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
ONHOST_UI_DEMO=false                       # true only on a prototype box: surfaces keep their local demo store
ONHOST_SURFACES_PATH=                      # empty = apps/surfaces of this checkout
ONHOST_WHITELABEL_CNAME=panel.onhost.cz    # CNAME target for partners' white-label panels
ONHOST_STATUS_CNAME=                       # CNAME target of customers' own status hosts; empty = the portal host

# ── Logging, errors, traces ───────────────────────────────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info                             # production: warning
LOG_DAILY_DAYS=14
SENTRY_DSN=                                # error tracking (redacted envelopes with the correlation id); empty = off
OTEL_EXPORTER_OTLP_ENDPOINT=               # http://otel-collector:4318 — spans of commands, operation steps and provider calls
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=onhost-control-plane
ONHOST_TRACE_URL=                          # Grafana Explore link template with {trace_id} — enables "Trasa" in the console

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=onhost_staging
DB_USERNAME=onhost
DB_PASSWORD=
DB_SSLMODE=prefer                          # production: require

# ── Redis (cache, queue, sessions) ────────────────────────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
CACHE_STORE=redis
CACHE_PREFIX=onhost_staging                # production: onhost
QUEUE_CONNECTION=redis                     # workers: onhost-queue@default, mails, provider-* (infra/systemd)
SESSION_DRIVER=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Secrets and identity ──────────────────────────────────────────────────────────────────────────────────────────────
ONHOST_SECRETS_DRIVER=db                   # db (encrypted with APP_KEY) | openbao; `env` is refused outside development
OPENBAO_ADDR=                              # only with ONHOST_SECRETS_DRIVER=openbao
OPENBAO_ROLE_ID=
OPENBAO_SECRET_ID=
OPENBAO_NAMESPACE=
ONHOST_STAFF_MFA_REQUIRED=true             # staff accounts must have TOTP/passkey before they can sign in
# critical staff actions take a second person (docs/runbooks/approvals.md); false = one operator runs the platform alone
ONHOST_FOUR_EYES=true
ONHOST_APPROVAL_TTL_HOURS=24
# TASK-0021: a password change revokes the user's personal API tokens (a reset always does); false = tokens kept, the mail says so
ONHOST_PASSWORD_CHANGE_REVOKES_API_ACCESS=true
ONHOST_STEP_UP_TTL=10                      # minutes a fresh step-up covers HIGH-risk commands
ONHOST_SESSION_TTL=720
OIDC_ENABLED=false                         # staff SSO (OIDC); issuer + client id, the client secret via OIDC_CLIENT_SECRET_REF
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET_REF=db://oidc/staff

# ── Mail ──────────────────────────────────────────────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@staging.onhost.cz # SPF/DKIM/DMARC for this sender before the first customer
MAIL_FROM_NAME="${APP_NAME}"
ONHOST_STAFF_DIGEST_TO=provoz@onhost.cz    # daily operations digest recipients (comma-separated)

# ── Legal entity (documents, VIES, proformas) — `php artisan onhost:production:prepare --legal` writes it ─────────────
ONHOST_BILLING_TIMEZONE=Europe/Prague     # the accounting day of documents (tax date, number series year), whatever zone the servers run in
ONHOST_LEGAL_ENTITY=onhost-cz
ONHOST_LEGAL_NAME=
ONHOST_ICO=
ONHOST_DIC=
ONHOST_VAT_ID=
ONHOST_STREET=
ONHOST_CITY=
ONHOST_ZIP=
ONHOST_BANK_IBAN=                          # printed on proformas, top-up instructions and QR codes
ONHOST_BANK_BIC=
ONHOST_BANK_ACCOUNT=
ONHOST_BANK_FIO_TOKEN=                     # Fio read-only API token → onhost:bank:sync matches transfers by variable symbol
EINVOICE_DRIVER=peppol                     # the Peppol access point is used only once PEPPOL_SENDER_ID and the secret are set
PEPPOL_SENDER_ID=
PEPPOL_SECRET_REF=db://einvoice/peppol

# ── Payments ──────────────────────────────────────────────────────────────────────────────────────────────────────────
PAYMENT_GATEWAY=comgate                    # comgate | gopay | stripe
COMGATE_MERCHANT=                          # staging: the Comgate test merchant; production: the live merchant id
COMGATE_SECRET=                            # or COMGATE_SECRET_REF=db://payments/comgate stored with onhost:integrations:secret
COMGATE_TEST=true                          # production: false
COMGATE_RECURRING=true                     # stored cards for automatic top-ups (recurring payments on the merchant contract)
COMGATE_CALLBACK_IPS=                      # optional allow-list of Comgate call-back addresses
GOPAY_GOID=
GOPAY_SECRET_REF=db://payments/gopay
GOPAY_RECURRING=true
STRIPE_SECRET_REF=db://payments/stripe
STRIPE_RECURRING=true

# ── Order risk and bot protection ─────────────────────────────────────────────────────────────────────────────────────
ONHOST_ORDER_RISK=true                     # intake pre-check; suspicious orders wait for a person
ONHOST_ORDER_RISK_HOLD=60
ONHOST_ORDER_RISK_FEEDBACK_STEP=5
ONHOST_ORDER_RISK_GEO_ENDPOINT=            # e.g. https://get.geojs.io/v1/ip/country/{ip}.json; empty = no country signal
ONHOST_ORDER_DUPLICATE_WINDOW_MINUTES=15
# an order nobody paid is cancelled after this many days (its proforma is voided, the transfer is no longer matched)
ONHOST_ORDER_UNPAID_EXPIRE_DAYS=14
ONHOST_ORDER_MAX_QUANTITY=10               # a cart line with a quantity becomes that many lines (one line is one service)
ONHOST_ORDER_MAX_LINES=50                  # lines one order may hold
# a domain-create whose answer was lost is repeated only after the registry has not known the name for this long
ONHOST_DOMAIN_RECREATE_AFTER_SECONDS=600
TURNSTILE_SITE_KEY=                        # Cloudflare Turnstile; empty = off (staging: the always-pass test keys work)
TURNSTILE_SECRET_KEY=
ONHOST_TURNSTILE_ENFORCE_REGISTER=true
ONHOST_TURNSTILE_ENFORCE_FORMS=true

# ── Registrars and DNS ────────────────────────────────────────────────────────────────────────────────────────────────
WEDOS_TEST_MODE=true                       # production: false (WAPI test flag makes registry operations dry runs)
WEDOS_FORCE_IP_RESOLVE=v4                  # WAPI over the allow-listed IPv4 egress
WEDOS_EGRESS_IP=                           # the IPv4 address allow-listed at WEDOS (doctor checks it)
ONHOST_REGISTRAR_PREFERENCE=wedos,subreg
ONHOST_REGISTRAR_COST_TTL_HOURS=24
ONHOST_FX_EUR_CZK=25.0
ONHOST_FX_USD_CZK=23.0
ONHOST_DOMAIN_TERMS_URL=/dokumenty/podminky-registrace-domen
ONHOST_DOMAIN_RENEW_LEAD_DAYS=14
ONHOST_DOMAIN_MISSING_CONFIRM_HOURS=36     # a domain the registrar no longer has is closed (renewals stopped) after it stayed away this long
ONHOST_DOMAIN_GRACE_RETRY_DAYS=20
ONHOST_PLATFORM_ZONES=staging.onhost.cz    # zones adopted with onhost:dns:adopt (hosting subdomains get A/AAAA rows)
ONHOST_PLATFORM_ORGANIZATION_SLUG=onhost-platform
ONHOST_DNS_NAMESERVERS=ns1.onhost.cz,ns2.onhost.cz   # the NS set new zones get
ONHOST_NSSET_HANDLE=NSSET-ONHOST           # CZ.NIC NSSET handle for .cz registrations
ONHOST_TECH_CONTACT_HANDLE=
ONHOST_SPF_INCLUDE=_spf.onhost.cz          # placed into hosted zones as include:
ONHOST_DNS_MAX_RECORDS=500                 # records one zone may hold
ONHOST_DNS_MAX_PENDING=200                 # changes one zone may hold waiting to be published
ONHOST_DNS_DRIFT_BATCH=200                 # zones compared with their provider per night (onhost:dns:drift)
ONHOST_FX_FETCH=true                       # VAT in CZK on documents in another currency: ask the Czech National Bank while issuing when the day's list is missing (public list, no key; onhost:fx:sync runs anyway)
ONHOST_FX_MAX_AGE_DAYS=7                   # an older list is not a rate of the day: the document waits for the bank
ONHOST_FX_TIMEOUT=5                        # seconds the bank gets to answer
ONHOST_CNB_RATES_URL=https://www.cnb.cz/cs/financni-trhy/devizovy-trh/kurzy-devizoveho-trhu/kurzy-devizoveho-trhu/denni_kurz.txt
ONHOST_MAIL_HOST=mail.onhost.cz            # MX target for hosted mail domains
ONHOST_MAIL_IMAP_PORT=993                  # what a mail client is told: IMAP over SSL/TLS
ONHOST_MAIL_POP3_PORT=995                  # POP3 over SSL/TLS
ONHOST_MAIL_SMTP_PORT=587                  # submission with STARTTLS

# ── Provisioning ──────────────────────────────────────────────────────────────────────────────────────────────────────
ONHOST_DEFAULT_REGION=cz1
ONHOST_VM_HOSTNAME_SUFFIX=cust.staging.onhost.cz
ONHOST_VM_SEARCH_DOMAIN=staging.onhost.cz
ONHOST_WEB_PREVIEW_SUFFIX=web.staging.onhost.cz
ONHOST_STAGING_SUFFIX=web.staging.onhost.cz
ONHOST_SITE_CLAIM_GRACE_DAYS=30            # days a site may hold a name nothing proves is its customer's before operators hear
ONHOST_PARKING_IPV4=                       # address parked domains point at
ONHOST_PROVIDER_TIMEOUT=10
ONHOST_PROVIDER_MAX_BODY_BYTES=8388608
ONHOST_PROVIDER_DIAGNOSTIC_RESERVE=0.05
ONHOST_OPERATION_RETRY_UNTIL=21600         # seconds an operation keeps retrying a transient provider fault (6 h)
ONHOST_DRIFT_AUTO_REPAIR=false
ONHOST_CAPACITY_GATE=true
ONHOST_RETENTION_AFTER_TERMINATION_DAYS=30
# days between the owner's request to erase the whole account and the erasure; it can be cancelled meanwhile
ONHOST_DELETION_GRACE_DAYS=14
ONHOST_SERVICE_RENEW_LEAD_DAYS=7
ONHOST_DUNNING_SUSPEND_DAYS=30
ONHOST_QUEUE_BACKLOG_THRESHOLD=25
ONHOST_QUEUE_BACKLOG_AGE_MINUTES=5
ONHOST_QUEUE_AUTOSCALE=false               # true = onhost:queue:scale --apply every 5 minutes
ONHOST_QUEUE_MAX_HELPERS=3
ONHOST_QUEUE_COOLDOWN_MINUTES=15
ONHOST_QUEUE_MAX_TIME=900
# operations forget the passwords they carried: a generated one is shown this long, a failed run keeps its input this long for a retry
ONHOST_OPERATION_SECRET_REVEAL_MINUTES=30
ONHOST_OPERATION_SECRET_FAILED_DAYS=7
ONHOST_LATENCY_TARGET_SECONDS=30           # p95 target for actions a person waits for; judged by onhost:doctor and the operations board
ONHOST_REBALANCE_HIGH=0.85
ONHOST_REBALANCE_LOW=0.6
ONHOST_REBALANCE_TARGET=0.75
ONHOST_NODE_SAMPLES_RETENTION_DAYS=30
ONHOST_CAPACITY_WARN_DAYS=30
ONHOST_CAPACITY_BUDGET_MONTHLY_MINOR=0     # monthly cap on vendor node orders (minor units), 0 = none
ONHOST_CAPACITY_BUDGET_CURRENCY=EUR
ONHOST_NODE_BOOTSTRAP_CALLBACK=            # base URL vendor-ordered nodes call back (default APP_URL)
ONHOST_NODE_BOOTSTRAP_SSH_KEY=             # the operator's public key placed on vendor-ordered nodes by cloud-init
ONHOST_NODE_BOOTSTRAP_USER_DATA=
ONHOST_BMC_TEMP_WARN_C=75
ONHOST_GAME_NODE_RESERVE_MB=1024           # RAM left to the host when a game node limit is detected from Wings
ONHOST_GAME_UPLOAD_MAX_MB=100
ONHOST_GAME_OPERATOR_VARIABLES_REF=db://game/operator-variables
ONHOST_GAME_OPERATOR_ROTATION_DAYS=180
# game configurator on the public web: base plan and slider maximums (prices are catalogue options of the game product)
ONHOST_GAME_CONFIGURATOR_PLAN=game-custom
ONHOST_GAME_MAX_RAM_GB=64
ONHOST_GAME_MAX_VCPU=8
# header art of the game tiles, fetched once by the control plane and served from our origin ({appid} = Steam app id)
ONHOST_GAME_ART_URL=https://cdn.cloudflare.steamstatic.com/steam/apps/{appid}/header.jpg

# ── Console, edge, metrics ────────────────────────────────────────────────────────────────────────────────────────────
ONHOST_CONSOLE_RELAY_KEY=                  # shared secret of the websocket console relay (infra/console-relay)
ONHOST_CONSOLE_RELAY_URL=                  # wss://relay.staging.onhost.cz
ONHOST_CONSOLE_TOKEN_TTL=120
ONHOST_METRICS_TOKEN=                      # bearer for /metrics (Prometheus)
ONHOST_METRICS_ALLOW_IPS=127.0.0.1,::1
ONHOST_CRITICAL_DOMAINS=staging.onhost.cz  # platform domains whose expiry pages the on-call (comma-separated); production: onhost.cz

# ── Files, backups, virus scan ────────────────────────────────────────────────────────────────────────────────────────
ONHOST_FILES_DISK=s3                       # marketplace evidence and data exports: local | s3
ONHOST_FILES_SIGNED_TTL=15
ONHOST_EVIDENCE_RETENTION_MONTHS=36
ONHOST_PLATFORM_BACKUP_DISK=s3             # control plane backups (database dump + private files) — off the server
ONHOST_PLATFORM_BACKUP_RETENTION_DAYS=30
# a service is archived before it is deleted (files, databases, metadata) and the archive is kept this long
ONHOST_SERVICE_ARCHIVE_DAYS=60
ONHOST_DELETE_GRACE_DAYS=30
ONHOST_DELETE_IDENTITY_CHECKS=5
ONHOST_ARCHIVE_DOWNLOAD_FEE_CZK=50000
ONHOST_ARCHIVE_DOWNLOAD_FEE_EUR=2000
ONHOST_STALE_BACKUP_HOURS=48
ONHOST_ARCHIVE_VERIFY_DAYS=14
ONHOST_ARCHIVE_VERIFY_BATCH=3
ONHOST_GAME_ARCHIVE_TIMEOUT=1800
ONHOST_ARCHIVE_DOWNLOAD_TIMEOUT=900
ONHOST_PG_BIN=                             # pg_dump/pg_restore of the server's version (aaPanel: /www/server/pgsql/bin); empty = auto-detect
ONHOST_BACKUP_OFFSITE_DISK=s3              # off-site copies of customer site backups; empty = none
ONHOST_BACKUP_DAILY_HOUR=2
ONHOST_RESCUE_HOURS=8
# manual backups a customer may keep per web service at once (they live on the platform's backup disk); the plan's `manual_backups` entitlement overrides it
ONHOST_BACKUP_MANUAL_MAX=5
ONHOST_BACKUP_COVERAGE_DAYS=3              # onhost:doctor names web services without a finished backup in this many days
ONHOST_UPLOAD_MAX_BYTES=2147483648
AWS_ACCESS_KEY_ID=                         # the S3-compatible bucket behind the three disks above (MinIO/R2/Hetzner)
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=onhost-staging
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
ONHOST_CLAMAV_HOST=                        # clamd (Ansible role onhost_clamav or the compose service); empty = uploads not scanned
ONHOST_CLAMAV_PORT=3310
ONHOST_CLAMAV_ENFORCE=true
ONHOST_CLAMAV_TIMEOUT=30

# ── Web toolkit ───────────────────────────────────────────────────────────────────────────────────────────────────────
ONHOST_CDN_CLOUDFLARE_SECRET_REF=          # db://cdn/cloudflare (keys token, account_id via onhost:secrets:set); empty = CDN not offered
ONHOST_ACME_DIRECTORY=https://acme-staging-v02.api.letsencrypt.org/directory   # production: https://acme-v02.api.letsencrypt.org/directory
ONHOST_ACME_CONTACT=
ONHOST_ACME_RENEW_DAYS=30
ONHOST_CERT_WATCH_RENEW_DAYS=10            # days left at which the platform asks for a site certificate the panel has not renewed
ONHOST_EGRESS_DENY_CIDRS=
ONHOST_EGRESS_ALLOW_CIDRS=
ONHOST_MAIL_HEALTH_WINDOW=30
ONHOST_MAIL_HEALTH_MIN_ERRORS=3
ONHOST_MAIL_HEALTH_STALLED=15
ONHOST_MONITORING_FAILURES=3
ONHOST_MONITORING_POWER_PASSES=2
ONHOST_WORK_OFFER_VALID_DAYS=14
ONHOST_WORK_OFFER_MAX_NET=250000
ONHOST_MONITORING_RETENTION_DAYS=90

# ── On-call ───────────────────────────────────────────────────────────────────────────────────────────────────────────
ONHOST_ONCALL_PROVIDER=                    # pagerduty | opsgenie | webhook; empty = alerts only in the console
ONHOST_ONCALL_SECRET_REF=db://oncall/pager # {routing_key} | {api_key, base_url?} | {url, secret}
ONHOST_ONCALL_INBOUND_SECRET=              # pager call-backs and Alertmanager → /v1/webhooks/alertmanager (bearer)
ONHOST_ONCALL_ESCALATE_MINUTES=15
ONHOST_ONCALL_MAX_ESCALATIONS=2

# ── Discord, AI assistant ─────────────────────────────────────────────────────────────────────────────────────────────
ONHOST_DISCORD_APPLICATION_ID=             # empty = Discord off
ONHOST_DISCORD_PUBLIC_KEY=
ONHOST_DISCORD_BOT_SECRET_REF=db://integrations/discord
ONHOST_AI_USER_PER_HOUR=40                 # model answers one person gets in an hour; past it the assistant answers from the help centre
ONHOST_AI_STAFF_PER_HOUR=120               # the same for a member of staff (chat over a customer's account, reply drafts)
ONHOST_AI_ORG_PER_DAY=300                  # model answers one organization gets in a day
ONHOST_AI_TOKENS_PER_DAY=3000000           # the platform's daily ceiling, input + output; 0 = none
ONHOST_AI_ENABLED=false                    # support assistant; the API key goes in with onhost:secrets:set <ref> api_key
ONHOST_AI_DRIVER=anthropic                 # anthropic | openai_compatible
AI_ANTHROPIC_MODEL=claude-sonnet-5
AI_ANTHROPIC_SECRET_REF=db://ai/anthropic
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_MODEL=gpt-4.1-mini
AI_OPENAI_SECRET_REF=db://ai/openai

# ── Commercial defaults (all editable in the console; these are only the first values) ───────────────────────────────
ONHOST_CHARGEBACK_PERCENT=70
ONHOST_MARKETPLACE_COMMISSION=20
ONHOST_MARKETPLACE_AUTO_ACCEPT_DAYS=14
ONHOST_MARKETPLACE_OVERDUE_GRACE_DAYS=7
ONHOST_MARKETPLACE_LATE_CREDIT_PCT=5
ONHOST_MARKETPLACE_LATE_CREDIT_CAP=50
ONHOST_MARKETPLACE_MISSED_PERIOD_CREDIT=50
ONHOST_MARKETPLACE_PERIOD_WARN_PCT=80
ONHOST_REFERRAL_CREDIT=20000
ONHOST_REFERRAL_WELCOME_CREDIT=10000
ONHOST_REFERRAL_MONTHLY_CAP=20
ONHOST_REFERRAL_CLAWBACK_DAYS=90
ONHOST_STREAK_MONTHS=12
ONHOST_STREAK_DISCOUNT=5
ONHOST_LOYALTY_FORECAST_DEFAULT_PCT=25
ONHOST_CHARGEBACK_CLUSTER_THRESHOLD=3
ONHOST_CHARGEBACK_CLUSTER_DAYS=30
ONHOST_SANDBOX_CREDIT=500000
ONHOST_PRICING_EU_ADJUST=5
ONHOST_PARTNER_AUTO_RATE_LOCK_MONTHS=6
ONHOST_PARTNER_AUTO_CLEAN_MONTHS=12
ONHOST_PARTNER_DEFAULT_MODEL=share
ONHOST_GREEN_CZ1_SOURCE=renewable
ONHOST_GREEN_CZ1_GCO2=20
ONHOST_GREEN_CZ1_PUE=1.25
ONHOST_GREEN_CZ1_RENEWABLE=100
ONHOST_GREEN_WATTS_PER_GB=3.5
ONHOST_GREEN_MEASURED_MAX_AGE_HOURS=24

VITE_APP_NAME="${APP_NAME}"
