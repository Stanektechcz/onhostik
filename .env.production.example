# ONhost control plane — production environment template (go-live checklist). Copy to /etc/onhost/app.env, fill every
# value, never commit the result. Secrets of provider instances are NOT here: store them with
# `php artisan onhost:integrations:secret <instance> <key> --check` (encrypted, ONHOST_SECRETS_DRIVER=db or openbao).
APP_NAME=ONhost
APP_ENV=production
APP_KEY=                                  # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://onhost.cz
APP_LOCALE=cs
SANCTUM_STATEFUL_DOMAINS=onhost.cz,www.onhost.cz
SESSION_SECURE_COOKIE=true

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=onhost
DB_USERNAME=onhost
DB_PASSWORD=
REDIS_HOST=
REDIS_PASSWORD=
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

ONHOST_SECRETS_DRIVER=db                  # db (encrypted with APP_KEY) or openbao; env is refused in production
ONHOST_STAFF_MFA_REQUIRED=true
ONHOST_UI_DEMO=false

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@onhost.cz
MAIL_FROM_NAME=ONhost
ONHOST_STAFF_DIGEST_TO=provoz@onhost.cz

# legal entity (php artisan onhost:production:prepare --legal writes it)
ONHOST_LEGAL_NAME=
ONHOST_ICO=
ONHOST_DIC=
ONHOST_VAT_ID=
ONHOST_STREET=
ONHOST_CITY=
ONHOST_ZIP=
ONHOST_BANK_IBAN=
ONHOST_BANK_BIC=
ONHOST_BANK_ACCOUNT=
ONHOST_BANK_FIO_TOKEN=                    # bank statement import

# payments
COMGATE_MERCHANT=
COMGATE_SECRET=
COMGATE_TEST=false
COMGATE_RECURRING=true

# registrars
WEDOS_TEST_MODE=false

# files, backups, scanning
ONHOST_FILES_DISK=s3
ONHOST_PLATFORM_BACKUP_DISK=s3
ONHOST_PLATFORM_BACKUP_RETENTION_DAYS=30
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
ONHOST_CLAMAV_HOST=
ONHOST_CLAMAV_PORT=3310

# edge, console, observability
ONHOST_CONSOLE_RELAY_KEY=
ONHOST_CONSOLE_RELAY_URL=wss://relay.onhost.cz
ONHOST_METRICS_TOKEN=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
ONHOST_TRACE_URL=
ONHOST_ONCALL_PROVIDER=                   # pagerduty | opsgenie | webhook
ONHOST_ONCALL_INBOUND_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
