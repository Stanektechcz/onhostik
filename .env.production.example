##############################################################################
# OnHost.cz — PRODUKČNÍ .env šablona
# Zkopírujte do .env a vyplňte VŠECHNY hodnoty před prvním spuštěním.
# NIKDY necommitujte tento soubor s vyplněnými hodnotami do gitu.
##############################################################################

APP_NAME="OnHost.cz"
APP_ENV=production
APP_KEY=                          # php artisan key:generate
APP_DEBUG=false
APP_TIMEZONE=Europe/Prague
APP_URL=https://onhost.cz

CUSTOMER_PANEL_URL=https://onhost.cz/panel

APP_LOCALE=cs
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=cs_CZ

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# ─────────────────────────────────────────────────────────────────────────────
# Databáze (MySQL/MariaDB)
# ─────────────────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=onhost
DB_USERNAME=onhost
DB_PASSWORD=                      # VYPLŇTE silné heslo

# ─────────────────────────────────────────────────────────────────────────────
# Session, Cache, Queue — v produkci DATABASE nebo REDIS (NIKDY ne sync)
# ─────────────────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.onhost.cz        # křížové subdomény (panel + admin)
SESSION_SECURE_COOKIE=true        # HTTPS only — NIKDY false v produkci
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database         # nebo redis pro vyšší výkon
CACHE_STORE=database              # nebo redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─────────────────────────────────────────────────────────────────────────────
# Mail — SMTP pro produkci
# ─────────────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=                        # VYPLŇTE SMTP host
MAIL_PORT=587
MAIL_USERNAME=                    # VYPLŇTE
MAIL_PASSWORD=                    # VYPLŇTE
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@onhost.cz"
MAIL_FROM_NAME="OnHost.cz"

# ─────────────────────────────────────────────────────────────────────────────
# Admin seed (POUZE první spuštění — odstraňte po vytvoření admin účtu)
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@onhost.cz
ADMIN_PASSWORD=                   # VYPLŇTE silné heslo — ihned po nasazení změňte

# ─────────────────────────────────────────────────────────────────────────────
# Billing
# ─────────────────────────────────────────────────────────────────────────────
BILLING_CURRENCY_DEFAULT=CZK
BILLING_INVOICE_DUE_DAYS=14
BILLING_CREDIT_LOW_THRESHOLD=10000
BILLING_COMPANY_NAME=             # VYPLŇTE název firmy / jméno (např. "Adrian Staněk")
BILLING_COMPANY_IC=               # VYPLŇTE IČO (povinné pro daňové doklady)
BILLING_COMPANY_DIC=              # VYPLŇTE DIČ — pokud jste plátce DPH (např. CZ08094616)
BILLING_COMPANY_STREET=           # VYPLŇTE ulici a číslo popisné (povinné pro daňové doklady)
BILLING_COMPANY_CITY=             # VYPLŇTE město
BILLING_COMPANY_ZIP=              # VYPLŇTE PSČ
BILLING_COMPANY_COUNTRY=CZ        # CZ = Česká republika (výchozí)
BILLING_BANK_CZK=                 # VYPLŇTE číslo bankovního účtu CZK (formát: NNNNNN/KBKB)
BILLING_BANK_EUR=                 # VYPLŇTE IBAN pro EUR platby (volitelné)

# ─────────────────────────────────────────────────────────────────────────────
# Comgate (platební brána)
# Testovací merchant: https://portal.comgate.cz/ → Sandbox
# Ostrý merchant: vyplňte po schválení účtu
# ─────────────────────────────────────────────────────────────────────────────
COMGATE_MERCHANT_ID=              # VYPLŇTE
COMGATE_SECRET=                   # VYPLŇTE (nikdy nelogovat!)
COMGATE_TEST_MODE=true            # true = testovací platby pro smoke test
                                  # → změňte na false AŽ v FÁZI L3 (staged cutover)
COMGATE_IP_WHITELIST=             # Comgate webhook IP (viz apidoc.comgate.cz)

# ─────────────────────────────────────────────────────────────────────────────
# Provisioning
# FÁZE 1: PROVISIONING_MOCK_MODE=false, ALLOW_REAL_WRITES=false → jen read/test
# FÁZE 2: AAPANEL_ALLOW_REAL_WRITES=true po ověření connection testu
# FÁZE 3: WAPI_ALLOW_REAL_WRITES=true po ověření WEDOS availability check
# ─────────────────────────────────────────────────────────────────────────────
PROVISIONING_MOCK_MODE=false
PROVISIONING_RETENTION_DAYS=30

# aaPanel (webhosting servery — Server záznamy se konfigurují v admin panelu)
AAPANEL_TIMEOUT=30
AAPANEL_VERIFY_TLS=false          # true pokud panel má platný SSL certifikát
AAPANEL_ALLOW_REAL_WRITES=false   # → true až po úspěšném connection testu

# WEDOS WAPI (domény)
WAPI_USER=                        # VYPLŇTE WEDOS e-mail
WAPI_PASSWORD=                    # VYPLŇTE WEDOS heslo (nikdy nelogovat!)
WAPI_TEST_MODE=false              # false = ostrá registrace
WAPI_ALLOW_REAL_WRITES=false      # → true až po ověření availability check

# AI / monitoring / zálohy — zapnout postupně po stabilizaci
AI_MOCK_MODE=true
MONITORING_MOCK_MODE=true
BACKUP_LOCAL_ONLY=true

# ─────────────────────────────────────────────────────────────────────────────
# Production approval gates — MĚŇTE POUZE vědomě, po otestování
# ─────────────────────────────────────────────────────────────────────────────
AI_ALLOW_REAL_CALLS=false

# ─────────────────────────────────────────────────────────────────────────────
# Partner / affiliate program
# ─────────────────────────────────────────────────────────────────────────────
PARTNER_COOKIE_NAME=onhost_ref           # název cookie s referral kódem
PARTNER_COOKIE_DAYS=30                   # délka platnosti cookie (dní)
PARTNER_DEFAULT_COMMISSION_RATE=10.0     # výchozí sazba provize (%)
PARTNER_COMMISSION_HOLD_DAYS=14          # ochranná lhůta před auto-approve (dní)
PARTNER_MIN_PAYOUT_MINOR=50000           # minimální výplata v haléřích (= 500 Kč)
PARTNER_SELF_REFERRAL_BLOCKED=true       # blokovat self-referral


# ─────────────────────────────────────────────────────────────────────────────
# Offsite DB zálohy (audit INFRA #7) — příkaz `php artisan db:backup`
# Disk backup-s3 (config/filesystems.php). Záloha na stejném serveru není záloha.
# ─────────────────────────────────────────────────────────────────────────────
BACKUP_DISK=backup-s3                     # offsite disk pro DB dump
BACKUP_KEEP_DAYS=14                       # rolling retention
S3_BACKUP_KEY=                            # VYPLŇTE (S3-kompatibilní úložiště)
S3_BACKUP_SECRET=                         # VYPLŇTE (nikdy nelogovat!)
S3_BACKUP_REGION=eu-central-1
S3_BACKUP_BUCKET=
S3_BACKUP_ENDPOINT=                       # např. https://s3.eu-central-1.wasabisys.com

# ─────────────────────────────────────────────────────────────────────────────
# Data retention (audit INFRA #180) — příkaz `php artisan retention:apply`
# 0 = ponechat navždy. Obchodní/účetní záznamy se NIKDY nemažou tímto.
# ─────────────────────────────────────────────────────────────────────────────
RETENTION_ACTIVITY_LOG_DAYS=365
RETENTION_LOGIN_HISTORY_DAYS=180
RETENTION_EXPORT_JOBS_DAYS=30
RETENTION_RESOLVED_INCIDENTS_DAYS=180

# ─────────────────────────────────────────────────────────────────────────────
# Bezpečnost / API / schvalování (volitelné, opt-in — výchozí = předchozí chování)
# ─────────────────────────────────────────────────────────────────────────────
SECURITY_CSP_ENFORCE=true                 # až po projití nasbíraných CSP reportů
AUTH_PASSWORD_BREACH_CHECK=true           # HIBP k-anonymita
AUTH_MAX_CONCURRENT_SESSIONS=0            # 0 = neomezeno; N = strop zařízení (audit 29)
APPROVALS_PAYOUT_ENABLED=false            # čtyři oči na výplatu reselleru (audit 74)
APPROVALS_PAYOUT_MIN_MINOR=0              # práh v haléřích, nad kterým je nutné schválení

# ─────────────────────────────────────────────────────────────────────────────
# Error tracking (volitelné) — composer require sentry/sentry-laravel
# ─────────────────────────────────────────────────────────────────────────────
# SENTRY_LARAVEL_DSN=
