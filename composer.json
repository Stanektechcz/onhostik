{
    "name": "onhost/platform",
    "description": "Onhost.cz — Hosting & Billing Platform (webhosting, gamehosting, cloud)",
    "keywords": ["laravel", "hosting", "billing", "onhost"],
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^3.1",
        "brick/money": "^0.9",
        "guzzlehttp/guzzle": "^7.9",
        "laravel/fortify": "^1.25",
        "laravel/framework": "^12.0",
        "laravel/horizon": "^5.47",
        "laravel/pulse": "^1.3",
        "laravel/reverb": "^1.4",
        "laravel/sanctum": "^4.0",
        "laravel/scout": "^10.12",
        "laravel/socialite": "^5.16",
        "laravel/tinker": "^2.10",
        "livewire/livewire": "^3.5",
        "meilisearch/meilisearch-php": "^1.12",
        "predis/predis": "^2.3",
        "spatie/laravel-activitylog": "^4.10",
        "spatie/laravel-data": "^4.15",
        "spatie/laravel-pdf": "^1.5",
        "spatie/laravel-permission": "^6.10",
        "spatie/laravel-query-builder": "^6.3",
        "spatie/laravel-settings": "^3.4",
        "spatie/laravel-translatable": "^6.9"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.15",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.4",
        "laravel/pint": "^1.18",
        "laravel/telescope": "^5.2",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.5",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "test": [
            "@php artisan test --parallel"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse --level=9 --memory-limit=2G"
        ],
        "format": [
            "vendor/bin/pint"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
