# ONhost edge — the customers' own status hosts (audit §5k-3, packaged §5l-3).
# Generated by `php artisan onhost:edge:config --format=caddy`; placeholders: {{PORTAL_HOST}} = the portal host name.
#
# Every host a customer verified (CNAME → {{PORTAL_HOST}}) is served by the portal; the certificate is issued on demand
# and Caddy asks the platform first — only verified, enabled status hosts get a certificate. The `on_demand_tls { ask }`
# global options live in Caddyfile.status-hosts.global (merged into the main Caddyfile); this file is imported from conf.d.

https:// {
    tls {
        on_demand
    }
    reverse_proxy {{UPSTREAM}} {
        header_up Host {host}
        header_up X-Forwarded-Proto https
    }
}
